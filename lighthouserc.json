{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "url": [
        "http://localhost:4173/index.html",
        "http://localhost:4173/case-studies/fraction.html",
        "http://localhost:4173/case-studies/payconnect.html",
        "http://localhost:4173/case-studies/scb.html",
        "http://localhost:4173/case-studies/winga.html",
        "http://localhost:4173/case-studies/yoma.html"
      ],
      "settings": {
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
