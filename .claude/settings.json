{
  "permissions": {
    "allow": [
      "Bash(npm run lint*)",
      "Bash(npm run check:*)",
      "Bash(npm run format*)",
      "Bash(npm run serve*)",
      "Bash(node scripts/*)",
      "Bash(npx lhci*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-generated.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-lint.mjs\""
          }
        ]
      }
    ]
  }
}
